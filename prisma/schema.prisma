generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth Required Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  // Safaruna specific fields
  role          Role      @default(PELERIN)
  firstName     String?
  lastName      String?
  phoneWhatsapp String?
  country       String?
  createdAt     DateTime  @default(now())
  lastLogin     DateTime?

  newsletterOptIn Boolean @default(false)

  // Relations
  accounts               Account[]
  sessions               Session[]
  // As a Pelerin
  reservations           Reservation[]      @relation("PelerinReservations")
  conversationsAsPelerin Conversation[]     @relation("PelerinConversations")
  messages               Message[]          @relation("PelerinMessages")
  legacyMessages         Message[]          @relation("LegacyMessageSender")
  reviews                Review[]
  experienceReviews      ExperienceReview[]
  savedDuas              SavedDua[]
  courseProgress         CourseProgress[]
  notifications          Notification[]
  analyticsEvents        AnalyticsEvent[]
  reservationDrafts      ReservationDraft[]
  referralCode           ReferralCode?
  sponsoredReferrals     Referral[]         @relation("ReferralSponsor")
  referral               Referral?          @relation("ReferralReferred")
  promoCodes             PromoCode[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  PELERIN
  GUIDE
  ADMIN
}

enum EmailIdentityKind {
  PELERIN
  GUIDE_APPLICATION
  GUIDE
}

// Registre minimal partagé qui garantit qu'une adresse normalisée ne peut
// appartenir qu'à un seul parcours (pèlerin ou guide).
model EmailIdentity {
  email                String            @id
  kind                 EmailIdentityKind
  quarantinedUntil     DateTime?
  sourceGuideAccountId String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([quarantinedUntil])
}

enum AdminRole {
  SUPERADMIN
  ADMIN
}

enum AdminAccountStatus {
  ACTIVE
  SUSPENDED
}

model AdminAccount {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String?
  passwordHash String?
  role         AdminRole
  status       AdminAccountStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  sessions                   AdminSession[]
  passwordResetTokens        AdminPasswordResetToken[]
  createdGuideProfiles       GuideProfile[]            @relation("GuideCreatedByAdmin")
  approvedGuideProfiles      GuideProfile[]            @relation("GuideApprovedByAdmin")
  reviewedApplications       GuideApplication[]        @relation("GuideApplicationReviewedBy")
  moderatedReviews           Review[]                  @relation("ReviewModeratedBy")
  moderatedExperienceReviews ExperienceReview[]        @relation("ExperienceReviewModeratedBy")
  auditLogs                  AuditLog[]                @relation("AuditActorAdmin")
}

model AdminPasswordResetToken {
  id             String       @id @default(cuid())
  tokenHash      String       @unique
  adminAccountId String
  adminAccount   AdminAccount @relation(fields: [adminAccountId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([adminAccountId, createdAt])
  @@index([expiresAt])
}

model AdminSession {
  id             String       @id @default(cuid())
  tokenHash      String       @unique
  adminAccountId String
  adminAccount   AdminAccount @relation(fields: [adminAccountId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  lastSeenAt     DateTime     @default(now())
  revokedAt      DateTime?
  ip             String?
  country        String?
  city           String?
  device         String?
  browser        String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([adminAccountId, expiresAt])
  @@index([expiresAt])
}

model AdminLoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  reason    String
  ip        String?
  country   String?
  city      String?
  device    String?
  browser   String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}

// Safaruna Core Models

model GuideProfile {
  id                    String           @id @default(cuid())
  guideAccountId        String?          @unique
  guideAccount          GuideAccount?    @relation(fields: [guideAccountId], references: [id], onDelete: SetNull)
  slug                  String?          @unique
  bio                   String?
  city                  String?
  gender                String?
  servesMakkah          Boolean          @default(false)
  servesMadinah         Boolean          @default(false)
  acceptingBookings     Boolean          @default(true)
  makkahNetUpTo6Cents   Int              @default(10000)
  makkahNetUpTo15Cents  Int              @default(13000)
  makkahNetUpTo32Cents  Int              @default(16000)
  madinahNetUpTo6Cents  Int              @default(10000)
  madinahNetUpTo15Cents Int              @default(13000)
  madinahNetUpTo32Cents Int              @default(16000)
  nationality           String?
  dateOfBirth           DateTime?
  experienceYears       Int?
  university            String?
  diplomaUrl            String?
  idDocUrl              String?
  videoUrl              String?
  bankAccountFirstName  String?
  bankAccountLastName   String?
  bankName              String?
  bankCountry           String?
  ibanEncrypted         String?
  bicEncrypted          String?
  status                ProfileStatus    @default(DRAFT)
  responseTimeAvg       String?
  completionRate        Int?             @default(0)
  commissionRate        Float            @default(0.15)
  interviewScore        Int?
  interviewNotes        String?
  interviewDate         DateTime?
  interviewedBy         String?
  createdByType         GuideCreatorType @default(LEGACY_UNKNOWN)
  createdByAdminId      String?
  createdByAdmin        AdminAccount?    @relation("GuideCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdByEmail        String?
  approvedByAdminId     String?
  approvedByAdmin       AdminAccount?    @relation("GuideApprovedByAdmin", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  approvedByEmail       String?
  approvedAt            DateTime?
  profileSubmittedAt    DateTime?
  cancellationCount     Int              @default(0)
  permanentlyDeactivatedAt DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @default(now()) @updatedAt

  // Relations
  packages             Package[]
  availabilities       Availability[]
  reservations         Reservation[]        @relation("GuideReservations")
  conversationsAsGuide Conversation[]       @relation("GuideConversations")
  languages            GuideLanguage[]
  places               GuidePlace[]
  transfers            Transfer[]
  reservationMissions  ReservationMission[]
  reservationHolds     ReservationHold[]
  earnings             GuideEarning[]
  reviews              Review[]
  changeRequests       GuideProfileChangeRequest[]
  reservationIncidents GuideReservationIncident[]
}

enum GuideAccountStatus {
  ACTIVE
  SUSPENDED
}

model GuideAccount {
  id                  String                    @id @default(cuid())
  email               String                    @unique
  passwordHash        String?
  emailVerified       DateTime?
  displayName         String?
  firstName           String?
  lastName            String?
  phoneWhatsapp       String?
  country             String?
  image               String?
  status              GuideAccountStatus        @default(ACTIVE)
  lastLoginAt         DateTime?
  registeredAt        DateTime                  @default(now())
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  guideProfile        GuideProfile?
  sessions            GuideSession[]
  loginAttempts       GuideLoginAttempt[]
  messages            Message[]
  passwordResetTokens GuidePasswordResetToken[]
  emailChangeRequests GuideEmailChangeRequest[]
}

model GuidePasswordResetToken {
  id             String       @id @default(cuid())
  tokenHash      String       @unique
  guideAccountId String
  guideAccount   GuideAccount @relation(fields: [guideAccountId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([guideAccountId, createdAt])
  @@index([expiresAt])
}

model GuideEmailChangeRequest {
  id             String       @id @default(cuid())
  guideAccountId String
  guideAccount   GuideAccount @relation(fields: [guideAccountId], references: [id], onDelete: Cascade)
  newEmail       String
  codeHash       String
  expiresAt      DateTime
  attempts       Int          @default(0)
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([guideAccountId, createdAt])
  @@index([newEmail, createdAt])
  @@index([expiresAt])
}

model GuideSession {
  id             String       @id @default(cuid())
  tokenHash      String       @unique
  guideAccountId String
  guideAccount   GuideAccount @relation(fields: [guideAccountId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  lastSeenAt     DateTime     @default(now())
  revokedAt      DateTime?
  ip             String?
  country        String?
  city           String?
  device         String?
  browser        String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([guideAccountId, expiresAt])
  @@index([expiresAt])
}

model GuideLoginAttempt {
  id             String        @id @default(cuid())
  email          String
  guideAccountId String?
  guideAccount   GuideAccount? @relation(fields: [guideAccountId], references: [id], onDelete: SetNull)
  success        Boolean
  reason         String
  ip             String?
  country        String?
  city           String?
  device         String?
  browser        String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([email, createdAt])
  @@index([guideAccountId, createdAt])
  @@index([createdAt])
}

enum GuideCreatorType {
  SUPERADMIN
  ADMIN
  SELF_APPLICATION
  LEGACY_UNKNOWN
  SYSTEM
}

enum ProfileStatus {
  DRAFT
  REVIEW
  ACTIVE
  SUSPENDED
}

enum GuideApplicationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum GuideApplicationSource {
  PUBLIC_FORM
  ADMIN
  IMPORT
}

enum GuideProfileChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model GuideProfileChangeRequest {
  id                        String                          @id @default(cuid())
  guideProfileId            String
  guideProfile              GuideProfile                    @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  activeKey                 String?                         @unique
  changes                   Json
  before                    Json
  status                    GuideProfileChangeRequestStatus @default(PENDING)
  requestedByGuideAccountId String
  requestedByEmail          String
  submittedIp               String?
  submittedCountry          String?
  submittedCity             String?
  submittedDevice           String?
  submittedBrowser          String?
  submittedUserAgent        String?
  reviewedByAdminId         String?
  reviewedByEmail           String?
  reviewNotes               String?
  reviewedAt                DateTime?
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt

  @@index([status, createdAt])
  @@index([guideProfileId, createdAt])
}

model GuideApplication {
  id                               String                 @id @default(cuid())
  firstName                        String
  lastName                         String
  email                            String
  whatsapp                         String?
  city                             String?
  gender                           String
  serviceCities                    String[]
  nationality                      String?
  dateOfBirth                      DateTime
  bio                              String?
  experienceYears                  Int?
  education                        String
  educationDetails                 String?
  languages                        String[]
  otherLanguages                   String?
  masteredPlaces                   String[]
  otherPlaces                      String?
  transportMode                    String
  transportModes                   String[]               @default([])
  transportDetails                 String?
  proposedOmraPriceCents           Int?
  proposedMadinahPackagePriceCents Int?
  proposedMadinahPlacePriceCents   Int?
  proposedMakkahPackagePriceCents  Int?
  proposedMakkahPlacePriceCents    Int?
  makkahIncludedDetails            String?
  makkahOtherDetails               String?
  madinahIncludedDetails           String?
  madinahOtherDetails              String?
  pricingDetails                   String?
  bankAccountFirstName             String
  bankAccountLastName              String
  bankName                         String
  bankCountry                      String
  ibanEncrypted                    String?
  bicEncrypted                     String?
  acceptedCharteAt                 DateTime
  submittedIp                      String?
  submittedCountry                 String?
  submittedDevice                  String?
  submittedUserAgent               String?
  source                           GuideApplicationSource @default(PUBLIC_FORM)
  status                           GuideApplicationStatus @default(PENDING)
  reviewNotes                      String?
  reviewedByAdminId                String?
  reviewedByAdmin                  AdminAccount?          @relation("GuideApplicationReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  reviewedByEmail                  String?
  reviewedAt                       DateTime?
  createdGuideProfileId            String?
  createdAt                        DateTime               @default(now())
  updatedAt                        DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
}

model GuideLanguage {
  id             String       @id @default(cuid())
  guideProfileId String
  guideProfile   GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  languageCode   String
  level          String // e.g., NATIVE, C2, B2
}

model GuidePlace {
  id             String       @id @default(cuid())
  guideProfileId String
  guideProfile   GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  placeKey       String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@unique([guideProfileId, placeKey])
}

model Place {
  id          String  @id @default(cuid())
  slug        String  @unique
  nameFr      String
  nameAr      String?
  city        String
  category    String
  description String
  duaText     String?
}

model Package {
  id                 String       @id @default(cuid())
  guideProfileId     String
  guideProfile       GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  name               String
  durationDays       Int
  pricePerPerson     Float
  priceGroup         Float?
  minPeople          Int          @default(1)
  maxPeople          Int
  cancellationPolicy String?

  reservations Reservation[]
}

model Availability {
  id             String             @id @default(cuid())
  guideProfileId String
  guideProfile   GuideProfile       @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  date           DateTime
  city           String             @default("BOTH")
  status         AvailabilityStatus @default(AVAILABLE)
  reservationId  String?
  reservation    Reservation?       @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@unique([guideProfileId, date, city])
  @@index([guideProfileId, city, date])
  @@index([reservationId])
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  UNAVAILABLE
}

enum ReferralStatus {
  REGISTERED
  QUALIFIED
}

enum PromoCodeKind {
  REFERRED_SIGNUP
  SPONSOR_REWARD
}

enum PromoCodeStatus {
  ACTIVE
  HELD
  REDEEMED
  EXPIRED
}

model ReferralCode {
  id        String   @id @default(cuid())
  ownerId   String   @unique
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  code      String   @unique
  createdAt DateTime @default(now())

  referrals Referral[]
  intents   ReferralOAuthIntent[]
}

model Referral {
  id                     String         @id @default(cuid())
  referralCodeId         String
  referralCode           ReferralCode   @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)
  sponsorId              String
  sponsor                User           @relation("ReferralSponsor", fields: [sponsorId], references: [id], onDelete: Restrict)
  referredUserId         String         @unique
  referredUser           User           @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Restrict)
  status                 ReferralStatus @default(REGISTERED)
  qualifiedReservationId String?        @unique
  qualifiedReservation   Reservation?   @relation("QualifiedReferral", fields: [qualifiedReservationId], references: [id], onDelete: SetNull)
  createdAt              DateTime       @default(now())
  qualifiedAt            DateTime?

  promoCodes PromoCode[]

  @@unique([sponsorId, referredUserId])
  @@index([sponsorId, status, createdAt])
  @@index([referralCodeId, createdAt])
}

model PromoCode {
  id              String          @id @default(cuid())
  code            String          @unique
  kind            PromoCodeKind
  status          PromoCodeStatus @default(ACTIVE)
  ownerId         String
  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  referralId      String
  referral        Referral        @relation(fields: [referralId], references: [id], onDelete: Restrict)
  discountBps     Int             @default(1000)
  expiresAt       DateTime
  reservedDraftId String?         @unique
  reservedDraft   ReservationDraft? @relation("PromoCodeReservationDraft", fields: [reservedDraftId], references: [id], onDelete: SetNull)
  reservationId   String?         @unique
  reservation     Reservation?    @relation("PromoCodeReservation", fields: [reservationId], references: [id], onDelete: SetNull)
  redeemedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([referralId, kind])
  @@index([ownerId, status, expiresAt])
  @@index([status, expiresAt])
}

model ReferralOAuthIntent {
  id             String       @id @default(cuid())
  referralCodeId String
  referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([expiresAt])
  @@index([referralCodeId, createdAt])
}

model Reservation {
  id                  String            @id @default(cuid())
  refNumber           String            @unique // SAF-2025-XXXXX
  pelerinId           String
  pelerin             User              @relation("PelerinReservations", fields: [pelerinId], references: [id])
  guideProfileId      String
  guideProfile        GuideProfile      @relation("GuideReservations", fields: [guideProfileId], references: [id])
  packageId           String
  package             Package           @relation(fields: [packageId], references: [id])
  startDate           DateTime
  endDate             DateTime
  nbPeople            Int
  transportOption     String?
  optionsJson         Json?
  basePrice           Float
  commissionAmount    Float
  totalPrice          Float
  status              ReservationStatus @default(PENDING)
  stripePaymentId     String?           @unique
  notes               String?
  selectedPlaces      Json?
  selectedCities      String?
  withTransport       Boolean           @default(false)
  withCar             Boolean           @default(false)
  gender              String?
  langue              String?
  arrivalPoint        String?
  cityOrder           String?
  guideBedProvided    Boolean           @default(false)
  ihramAlert          Boolean           @default(false)
  pricingJson         Json?
  reviewRequestSentAt DateTime?
  stayRating          Int?
  stayComment         String?
  feedbackSubmittedAt DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  reviews             Review[]
  experienceReview    ExperienceReview?
  missions            ReservationMission[]
  bookedDates         Availability[]
  guideEarnings       GuideEarning[]
  paymentAttempts     PaymentAttempt[]
  paymentTransactions PaymentTransaction[]
  qualifiedReferral   Referral?          @relation("QualifiedReferral")
  promoCode           PromoCode?         @relation("PromoCodeReservation")
  guideIncidents      GuideReservationIncident[]
}

model ReservationMission {
  id                           String                  @id @default(cuid())
  reservationId                String
  reservation                  Reservation             @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guideProfileId               String
  guideProfile                 GuideProfile            @relation(fields: [guideProfileId], references: [id])
  city                         String
  startDate                    DateTime
  endDate                      DateTime
  selectedPlaces               Json?
  localTransport               String?
  localTransportDays           Int                     @default(1)
  guideConfirmationStatus      GuideConfirmationStatus @default(PENDING)
  guideConfirmationRequestedAt DateTime?
  guideConfirmedAt             DateTime?
  createdAt                    DateTime                @default(now())

  @@unique([reservationId, city])
  @@index([guideProfileId, startDate, endDate])
  @@index([guideProfileId, guideConfirmationStatus, createdAt])
}

enum GuideConfirmationStatus {
  PENDING
  CONFIRMED
  DECLINED
  NO_RESPONSE
}

enum GuideReservationIncidentType {
  GUIDE_DECLINED
  NO_RESPONSE
}

enum GuideReservationIncidentStatus {
  PENDING
  COUNTED
  EXCUSED
}

model GuideReservationIncident {
  id              String                         @id @default(cuid())
  reservationId   String
  reservation     Reservation                    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guideProfileId  String
  guideProfile    GuideProfile                   @relation(fields: [guideProfileId], references: [id])
  type            GuideReservationIncidentType
  reason          String?
  status          GuideReservationIncidentStatus @default(PENDING)
  reportedAt      DateTime                       @default(now())
  reviewedByAdminId String?
  reviewedByEmail String?
  reviewNotes     String?
  reviewedAt      DateTime?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@unique([reservationId, guideProfileId])
  @@index([guideProfileId, status, reportedAt])
  @@index([status, reportedAt])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model PlacePrice {
  id             String   @id @default(cuid())
  placeKey       String   @unique
  price          Float    @default(50)
  isActive       Boolean  @default(true)
  includedInBase Boolean?
  netUpTo6Cents  Int?
  netUpTo15Cents Int?
  netUpTo32Cents Int?
}

model PlatformPricingSettings {
  id                    String   @id @default("global")
  guideServiceMarkupBps Int      @default(3000)
  travelMarkupBps       Int      @default(2000)
  updatedAt             DateTime @updatedAt
}

// ---------------------------------------------------------
// MESSAGING SYSTEM
// ---------------------------------------------------------

model Conversation {
  id             String       @id @default(cuid())
  pelerinId      String
  pelerin        User         @relation("PelerinConversations", fields: [pelerinId], references: [id])
  guideProfileId String
  guideProfile   GuideProfile @relation("GuideConversations", fields: [guideProfileId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages Message[]
}

enum MessageSenderType {
  PELERIN
  GUIDE
}

model Message {
  id                   String             @id @default(cuid())
  conversationId       String
  conversation         Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType           MessageSenderType?
  senderPelerinId      String?
  senderPelerin        User?              @relation("PelerinMessages", fields: [senderPelerinId], references: [id])
  senderGuideAccountId String?
  senderGuideAccount   GuideAccount?      @relation(fields: [senderGuideAccountId], references: [id])
  legacySenderId       String?            @map("senderId")
  legacySender         User?              @relation("LegacyMessageSender", fields: [legacySenderId], references: [id])
  content              String
  readAt               DateTime?
  createdAt            DateTime           @default(now())

  @@index([conversationId, senderType, readAt])
}

model Review {
  id                 String                 @id @default(cuid())
  reservationId      String?
  reservation        Reservation?           @relation(fields: [reservationId], references: [id])
  directReviewKey    String?                @unique
  guideProfileId     String
  guideProfile       GuideProfile           @relation(fields: [guideProfileId], references: [id])
  pelerinId          String
  pelerin            User                   @relation(fields: [pelerinId], references: [id])
  reviewerFirstName  String?
  reviewerCity       String?
  reviewerCountry    String?
  ratingOverall      Int
  ratingPunctuality  Int?
  ratingPedagogy     Int?
  ratingKnowledge    Int?
  comment            String
  guideResponse      String?
  status             ReviewModerationStatus @default(PENDING)
  moderatedByAdminId String?
  moderatedByAdmin   AdminAccount?          @relation("ReviewModeratedBy", fields: [moderatedByAdminId], references: [id], onDelete: SetNull)
  moderatedByEmail   String?
  moderatedAt        DateTime?
  moderationNote     String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([reservationId, guideProfileId])
  @@index([pelerinId, directReviewKey])
  @@index([guideProfileId, status, createdAt])
  @@index([status, createdAt])
}

model ExperienceReview {
  id                 String                 @id @default(cuid())
  userId             String
  user               User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  reservationId      String?                @unique
  reservation        Reservation?           @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  generalReviewKey   String?                @unique
  firstName          String
  city               String
  country            String
  rating             Int
  comment            String
  status             ReviewModerationStatus @default(PENDING)
  moderatedByAdminId String?
  moderatedByAdmin   AdminAccount?          @relation("ExperienceReviewModeratedBy", fields: [moderatedByAdminId], references: [id], onDelete: SetNull)
  moderatedByEmail   String?
  moderatedAt        DateTime?
  moderationNote     String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([userId, status, createdAt])
  @@index([status, moderatedAt, createdAt])
}

enum ReviewModerationStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

// ---------------------------------------------------------
// FINANCIAL: TRANSFERS
// ---------------------------------------------------------

model Transfer {
  id             String         @id @default(cuid())
  guideProfileId String
  guideProfile   GuideProfile   @relation(fields: [guideProfileId], references: [id])
  amount         Float
  commission     Float
  net            Float
  period         String
  status         TransferStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  earnings       GuideEarning[]
}

enum TransferStatus {
  PENDING
  PROCESSING
  PAID
}

model GuideEarning {
  id                String             @id @default(cuid())
  reservationId     String
  reservation       Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guideProfileId    String
  guideProfile      GuideProfile       @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  serviceNetCents   Int
  placesNetCents    Int
  transportNetCents Int
  hotelNetCents     Int
  totalNetCents     Int
  breakdown         Json
  status            GuideEarningStatus @default(UPCOMING)
  transferId        String?
  transfer          Transfer?          @relation(fields: [transferId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([reservationId, guideProfileId])
  @@index([guideProfileId, status, createdAt])
  @@index([transferId])
}

enum GuideEarningStatus {
  UPCOMING
  AVAILABLE
  PAID
  CANCELLED
}

// ---------------------------------------------------------
// SPIRITUAL / DAILY TOOLS (THE 360° EXPERIENCE)
// ---------------------------------------------------------

model Course {
  id           String  @id @default(cuid())
  slug         String  @unique
  title        String
  category     String
  durationMin  Int
  level        String
  description  String?
  videoUrl     String?
  thumbnailUrl String?

  progress CourseProgress[]
}

model CourseProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progressPct Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([userId, courseId])
}

model Dua {
  id              String  @id @default(cuid())
  category        String
  title           String?
  arabicText      String
  transliteration String?
  translationFr   String
  source          String?
  audioUrl        String?

  savedBy SavedDua[]
}

model SavedDua {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  duaId   String
  dua     Dua      @relation(fields: [duaId], references: [id], onDelete: Cascade)
  savedAt DateTime @default(now())

  @@unique([userId, duaId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model NewsletterSubscription {
  id          String   @id @default(cuid())
  email       String   @unique
  createdAt   DateTime @default(now())
  source      String   @default("blog")
  brevoSynced Boolean  @default(false)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique // Hash SHA-256 du jeton ; la valeur brute reste uniquement dans l'email.
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Registre transactionnel indépendant du métier. Le contenu n'est conservé
// que chiffré et temporairement lorsqu'une reprise est explicitement permise.
model EmailDelivery {
  id                String               @id @default(cuid())
  idempotencyKey    String               @unique
  provider          String               @default("BREVO")
  providerMessageId String?              @unique
  category          String
  recipientEmail    String
  referenceType     String?
  referenceId       String?
  status            String               @default("QUEUED")
  attempts          Int                  @default(0)
  maxAttempts       Int                  @default(3)
  nextAttemptAt     DateTime?
  payloadEncrypted  String?
  lastError         String?
  acceptedAt        DateTime?
  deliveredAt       DateTime?
  lastEventAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  events            EmailDeliveryEvent[]

  @@index([status, nextAttemptAt])
  @@index([category, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model EmailDeliveryEvent {
  id                String         @id @default(cuid())
  providerEventKey  String         @unique
  deliveryId        String?
  delivery          EmailDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  provider          String         @default("BREVO")
  providerMessageId String?
  event             String
  recipientEmail    String?
  reason            String?
  occurredAt        DateTime
  createdAt         DateTime       @default(now())

  @@index([deliveryId, occurredAt])
  @@index([providerMessageId])
  @@index([event, occurredAt])
}

model ReservationDraft {
  id              String            @id @default(cuid())
  refNumber       String            @unique
  data            String // JSON stringifié
  expiresAt       DateTime
  createdAt       DateTime          @default(now())
  stripeSessionId String?           @unique
  pelerinId       String
  pelerin         User              @relation(fields: [pelerinId], references: [id], onDelete: Cascade)
  holds           ReservationHold[]
  promoCode       PromoCode?        @relation("PromoCodeReservationDraft")

  @@index([pelerinId, createdAt])
}

enum PaymentAttemptStatus {
  CREATED
  PENDING
  SUCCEEDED
  EXPIRED
  FAILED
  CANCELLED
}

enum PaymentEventStatus {
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum PaymentTransactionType {
  CHARGE
  REFUND
  CHARGEBACK
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REVERSED
}

model PaymentAttempt {
  id                 String               @id @default(cuid())
  bookingRef         String
  reservationId      String?
  reservation        Reservation?         @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  provider           String
  providerCheckoutId String?
  providerPaymentId  String?
  status             PaymentAttemptStatus @default(CREATED)
  amountCents        Int
  currency           String               @default("EUR")
  checkoutExpiresAt  DateTime?
  paidAt             DateTime?
  failureCode        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  events             PaymentEvent[]
  transactions       PaymentTransaction[]

  @@unique([provider, providerCheckoutId])
  @@unique([provider, providerPaymentId])
  @@index([bookingRef, createdAt])
  @@index([reservationId])
  @@index([status, createdAt])
}

model PaymentEvent {
  id                  String             @id @default(cuid())
  attemptId           String?
  attempt             PaymentAttempt?    @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  provider            String
  providerEventId     String
  providerEventType   String
  providerObjectId    String?
  status              PaymentEventStatus @default(PROCESSING)
  processingAttempts  Int                @default(1)
  occurredAt          DateTime
  processingStartedAt DateTime           @default(now())
  processedAt         DateTime?
  lastError           String?
  metadata            Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([provider, providerEventId])
  @@index([attemptId, occurredAt])
  @@index([status, processingStartedAt])
  @@index([providerObjectId])
}

model PaymentTransaction {
  id                    String                   @id @default(cuid())
  bookingRef            String
  reservationId         String?
  reservation           Reservation?             @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  attemptId             String?
  attempt               PaymentAttempt?          @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  provider              String
  providerTransactionId String
  type                  PaymentTransactionType
  status                PaymentTransactionStatus
  amountCents           Int
  currency              String
  occurredAt            DateTime
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@unique([provider, type, providerTransactionId])
  @@index([bookingRef, occurredAt])
  @@index([reservationId])
  @@index([attemptId])
  @@index([status, occurredAt])
}

model ReservationHold {
  id             String           @id @default(cuid())
  draftRefNumber String
  draft          ReservationDraft @relation(fields: [draftRefNumber], references: [refNumber], onDelete: Cascade)
  guideProfileId String
  guideProfile   GuideProfile     @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  city           String
  date           DateTime
  expiresAt      DateTime
  createdAt      DateTime         @default(now())

  @@unique([guideProfileId, date])
  @@index([expiresAt])
  @@index([draftRefNumber])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  actor        String // email ou "system" ou "stripe"
  actorRole    String // "ADMIN" | "GUIDE" | "CLIENT" | "SYSTEM"
  action       String // "RESERVATION_CREATED" | "PAYMENT_CONFIRMED" etc.
  target       String? // refNumber, placeKey, userId...
  detail       String? // JSON ou texte libre
  ip           String?
  actorAdminId String?
  actorAdmin   AdminAccount? @relation("AuditActorAdmin", fields: [actorAdminId], references: [id], onDelete: SetNull)
  requestId    String?
  userAgent    String?
  before       Json?
  after        Json?

  @@index([actorAdminId, createdAt])
  @@index([action, createdAt])
}

// ---------------------------------------------------------
// PRIVACY-FIRST PRODUCT ANALYTICS
// ---------------------------------------------------------

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventName   String
  sessionHash String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  path        String?
  referrer    String?
  country     String?
  device      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([eventName, createdAt])
  @@index([sessionHash, createdAt])
  @@index([userId, createdAt])
}

model AnalyticsDailyAggregate {
  id             String   @id @default(cuid())
  day            DateTime
  eventName      String
  country        String   @default("UNKNOWN")
  device         String   @default("UNKNOWN")
  path           String   @default("")
  count          Int      @default(0)
  uniqueSessions Int      @default(0)
  revenueCents   Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([day, eventName, country, device, path])
  @@index([day])
  @@index([eventName, day])
}
