generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth Required Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  // Safaruna specific fields
  role          Role      @default(PELERIN)
  firstName     String?
  lastName      String?
  phoneWhatsapp String?
  country       String?
  createdAt     DateTime  @default(now())
  lastLogin     DateTime?

  newsletterOptIn Boolean @default(false)

  // Relations
  accounts     Account[]
  sessions     Session[]
  guideProfile GuideProfile?

  // As a Pelerin
  reservations           Reservation[]      @relation("PelerinReservations")
  conversationsAsPelerin Conversation[]     @relation("PelerinConversations")
  messages               Message[]
  reviews                Review[]
  savedDuas              SavedDua[]
  courseProgress         CourseProgress[]
  notifications          Notification[]
  analyticsEvents        AnalyticsEvent[]
  reservationDrafts      ReservationDraft[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  PELERIN
  GUIDE
  ADMIN
}

enum AdminRole {
  SUPERADMIN
  ADMIN
}

enum AdminAccountStatus {
  ACTIVE
  SUSPENDED
}

model AdminAccount {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String?
  passwordHash String?
  role         AdminRole
  status       AdminAccountStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  sessions              AdminSession[]
  createdGuideProfiles  GuideProfile[]     @relation("GuideCreatedByAdmin")
  approvedGuideProfiles GuideProfile[]     @relation("GuideApprovedByAdmin")
  reviewedApplications  GuideApplication[] @relation("GuideApplicationReviewedBy")
  auditLogs             AuditLog[]         @relation("AuditActorAdmin")
}

model AdminSession {
  id             String       @id @default(cuid())
  tokenHash      String       @unique
  adminAccountId String
  adminAccount   AdminAccount @relation(fields: [adminAccountId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  lastSeenAt     DateTime     @default(now())
  revokedAt      DateTime?
  ip             String?
  country        String?
  city           String?
  device         String?
  browser        String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([adminAccountId, expiresAt])
  @@index([expiresAt])
}

model AdminLoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  reason    String
  ip        String?
  country   String?
  city      String?
  device    String?
  browser   String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}

// Safaruna Core Models

model GuideProfile {
  id                    String           @id @default(cuid())
  userId                String           @unique
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  guideAccountId        String?          @unique
  guideAccount          GuideAccount?    @relation(fields: [guideAccountId], references: [id], onDelete: SetNull)
  slug                  String?          @unique
  bio                   String?
  city                  String?
  gender                String?
  servesMakkah          Boolean          @default(false)
  servesMadinah         Boolean          @default(false)
  acceptingBookings     Boolean          @default(true)
  makkahNetUpTo6Cents   Int              @default(10000)
  makkahNetUpTo15Cents  Int              @default(13000)
  makkahNetUpTo32Cents  Int              @default(16000)
  madinahNetUpTo6Cents  Int              @default(10000)
  madinahNetUpTo15Cents Int              @default(13000)
  madinahNetUpTo32Cents Int              @default(16000)
  nationality           String?
  experienceYears       Int?
  university            String?
  diplomaUrl            String?
  idDocUrl              String?
  videoUrl              String?
  ibanEncrypted         String?
  status                ProfileStatus    @default(DRAFT)
  responseTimeAvg       String?
  completionRate        Int?             @default(0)
  commissionRate        Float            @default(0.15)
  interviewScore        Int?
  interviewNotes        String?
  interviewDate         DateTime?
  interviewedBy         String?
  createdByType         GuideCreatorType @default(LEGACY_UNKNOWN)
  createdByAdminId      String?
  createdByAdmin        AdminAccount?    @relation("GuideCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdByEmail        String?
  approvedByAdminId     String?
  approvedByAdmin       AdminAccount?    @relation("GuideApprovedByAdmin", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  approvedByEmail       String?
  approvedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @default(now()) @updatedAt

  // Relations
  packages             Package[]
  availabilities       Availability[]
  reservations         Reservation[]        @relation("GuideReservations")
  conversationsAsGuide Conversation[]       @relation("GuideConversations")
  languages            GuideLanguage[]
  places               GuidePlace[]
  transfers            Transfer[]
  reservationMissions  ReservationMission[]
  reservationHolds     ReservationHold[]
  earnings             GuideEarning[]
}

enum GuideAccountStatus {
  ACTIVE
  SUSPENDED
}

model GuideAccount {
  id            String             @id @default(cuid())
  email         String             @unique
  passwordHash  String?
  emailVerified DateTime?
  displayName   String?
  firstName     String?
  lastName      String?
  phoneWhatsapp String?
  image         String?
  legacyUserId  String?            @unique
  status        GuideAccountStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  guideProfile  GuideProfile?
}

enum GuideCreatorType {
  SUPERADMIN
  ADMIN
  SELF_APPLICATION
  LEGACY_UNKNOWN
  SYSTEM
}

enum ProfileStatus {
  DRAFT
  REVIEW
  ACTIVE
  SUSPENDED
}

enum GuideApplicationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum GuideApplicationSource {
  PUBLIC_FORM
  ADMIN
  IMPORT
}

model GuideApplication {
  id                    String                 @id @default(cuid())
  firstName             String
  lastName              String
  email                 String
  whatsapp              String?
  city                  String?
  gender                String
  serviceCities         String[]
  nationality           String?
  bio                   String?
  experienceYears       Int?
  languages             String[]
  ibanEncrypted         String?
  acceptedCharteAt      DateTime
  submittedIp           String?
  submittedCountry      String?
  submittedDevice       String?
  submittedUserAgent    String?
  source                GuideApplicationSource @default(PUBLIC_FORM)
  status                GuideApplicationStatus @default(PENDING)
  reviewNotes           String?
  reviewedByAdminId     String?
  reviewedByAdmin       AdminAccount?          @relation("GuideApplicationReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  reviewedByEmail       String?
  reviewedAt            DateTime?
  createdGuideProfileId String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
}

model GuideLanguage {
  id             String       @id @default(cuid())
  guideProfileId String
  guideProfile   GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  languageCode   String
  level          String // e.g., NATIVE, C2, B2
}

model GuidePlace {
  id             String       @id @default(cuid())
  guideProfileId String
  guideProfile   GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  placeKey       String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@unique([guideProfileId, placeKey])
}

model Place {
  id          String  @id @default(cuid())
  slug        String  @unique
  nameFr      String
  nameAr      String?
  city        String
  category    String
  description String
  duaText     String?
}

model Package {
  id                 String       @id @default(cuid())
  guideProfileId     String
  guideProfile       GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  name               String
  durationDays       Int
  pricePerPerson     Float
  priceGroup         Float?
  minPeople          Int          @default(1)
  maxPeople          Int
  cancellationPolicy String?

  reservations Reservation[]
}

model Availability {
  id             String             @id @default(cuid())
  guideProfileId String
  guideProfile   GuideProfile       @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  date           DateTime
  city           String             @default("BOTH")
  status         AvailabilityStatus @default(AVAILABLE)
  reservationId  String?
  reservation    Reservation?       @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@unique([guideProfileId, date, city])
  @@index([guideProfileId, city, date])
  @@index([reservationId])
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  UNAVAILABLE
}

model Reservation {
  id               String            @id @default(cuid())
  refNumber        String            @unique // SAF-2025-XXXXX
  pelerinId        String
  pelerin          User              @relation("PelerinReservations", fields: [pelerinId], references: [id])
  guideProfileId   String
  guideProfile     GuideProfile      @relation("GuideReservations", fields: [guideProfileId], references: [id])
  packageId        String
  package          Package           @relation(fields: [packageId], references: [id])
  startDate        DateTime
  endDate          DateTime
  nbPeople         Int
  transportOption  String?
  optionsJson      Json?
  basePrice        Float
  commissionAmount Float
  totalPrice       Float
  status           ReservationStatus @default(PENDING)
  stripePaymentId  String?
  notes            String?
  selectedPlaces   Json?
  selectedCities   String?
  withTransport    Boolean           @default(false)
  withCar          Boolean           @default(false)
  gender           String?
  langue           String?
  arrivalPoint     String?
  cityOrder        String?
  guideBedProvided Boolean           @default(false)
  ihramAlert       Boolean           @default(false)
  pricingJson      Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  reviews       Review[]
  missions      ReservationMission[]
  bookedDates   Availability[]
  guideEarnings GuideEarning[]
}

model ReservationMission {
  id                 String       @id @default(cuid())
  reservationId      String
  reservation        Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guideProfileId     String
  guideProfile       GuideProfile @relation(fields: [guideProfileId], references: [id])
  city               String
  startDate          DateTime
  endDate            DateTime
  selectedPlaces     Json?
  localTransport     String?
  localTransportDays Int          @default(1)
  createdAt          DateTime     @default(now())

  @@unique([reservationId, city])
  @@index([guideProfileId, startDate, endDate])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model PlacePrice {
  id       String  @id @default(cuid())
  placeKey String  @unique
  price    Float   @default(50)
  isActive Boolean @default(true)
}

// ---------------------------------------------------------
// MESSAGING SYSTEM
// ---------------------------------------------------------

model Conversation {
  id             String       @id @default(cuid())
  pelerinId      String
  pelerin        User         @relation("PelerinConversations", fields: [pelerinId], references: [id])
  guideProfileId String
  guideProfile   GuideProfile @relation("GuideConversations", fields: [guideProfileId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
}

model Review {
  id                String      @id @default(cuid())
  reservationId     String
  reservation       Reservation @relation(fields: [reservationId], references: [id])
  pelerinId         String
  pelerin           User        @relation(fields: [pelerinId], references: [id])
  ratingOverall     Int
  ratingPunctuality Int?
  ratingPedagogy    Int?
  ratingKnowledge   Int?
  comment           String
  guideResponse     String?
  createdAt         DateTime    @default(now())
}

// ---------------------------------------------------------
// FINANCIAL: TRANSFERS
// ---------------------------------------------------------

model Transfer {
  id             String         @id @default(cuid())
  guideProfileId String
  guideProfile   GuideProfile   @relation(fields: [guideProfileId], references: [id])
  amount         Float
  commission     Float
  net            Float
  period         String
  status         TransferStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  earnings       GuideEarning[]
}

enum TransferStatus {
  PENDING
  PROCESSING
  PAID
}

model GuideEarning {
  id                String             @id @default(cuid())
  reservationId     String
  reservation       Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guideProfileId    String
  guideProfile      GuideProfile       @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  serviceNetCents   Int
  placesNetCents    Int
  transportNetCents Int
  hotelNetCents     Int
  totalNetCents     Int
  breakdown         Json
  status            GuideEarningStatus @default(UPCOMING)
  transferId        String?
  transfer          Transfer?          @relation(fields: [transferId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([reservationId, guideProfileId])
  @@index([guideProfileId, status, createdAt])
  @@index([transferId])
}

enum GuideEarningStatus {
  UPCOMING
  AVAILABLE
  PAID
  CANCELLED
}

// ---------------------------------------------------------
// SPIRITUAL / DAILY TOOLS (THE 360° EXPERIENCE)
// ---------------------------------------------------------

model Course {
  id           String  @id @default(cuid())
  slug         String  @unique
  title        String
  category     String
  durationMin  Int
  level        String
  description  String?
  videoUrl     String?
  thumbnailUrl String?

  progress CourseProgress[]
}

model CourseProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progressPct Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([userId, courseId])
}

model Dua {
  id              String  @id @default(cuid())
  category        String
  title           String?
  arabicText      String
  transliteration String?
  translationFr   String
  source          String?
  audioUrl        String?

  savedBy SavedDua[]
}

model SavedDua {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  duaId   String
  dua     Dua      @relation(fields: [duaId], references: [id], onDelete: Cascade)
  savedAt DateTime @default(now())

  @@unique([userId, duaId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model NewsletterSubscription {
  id          String   @id @default(cuid())
  email       String   @unique
  createdAt   DateTime @default(now())
  source      String   @default("blog")
  brevoSynced Boolean  @default(false)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ReservationDraft {
  id              String            @id @default(cuid())
  refNumber       String            @unique
  data            String // JSON stringifié
  expiresAt       DateTime
  createdAt       DateTime          @default(now())
  stripeSessionId String?           @unique
  pelerinId       String?
  pelerin         User?             @relation(fields: [pelerinId], references: [id], onDelete: Cascade)
  holds           ReservationHold[]

  @@index([pelerinId, createdAt])
}

model ReservationHold {
  id             String           @id @default(cuid())
  draftRefNumber String
  draft          ReservationDraft @relation(fields: [draftRefNumber], references: [refNumber], onDelete: Cascade)
  guideProfileId String
  guideProfile   GuideProfile     @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  city           String
  date           DateTime
  expiresAt      DateTime
  createdAt      DateTime         @default(now())

  @@unique([guideProfileId, date])
  @@index([expiresAt])
  @@index([draftRefNumber])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  actor        String // email ou "system" ou "stripe"
  actorRole    String // "ADMIN" | "GUIDE" | "CLIENT" | "SYSTEM"
  action       String // "RESERVATION_CREATED" | "PAYMENT_CONFIRMED" etc.
  target       String? // refNumber, placeKey, userId...
  detail       String? // JSON ou texte libre
  ip           String?
  actorAdminId String?
  actorAdmin   AdminAccount? @relation("AuditActorAdmin", fields: [actorAdminId], references: [id], onDelete: SetNull)
  requestId    String?
  userAgent    String?
  before       Json?
  after        Json?

  @@index([actorAdminId, createdAt])
  @@index([action, createdAt])
}

// ---------------------------------------------------------
// PRIVACY-FIRST PRODUCT ANALYTICS
// ---------------------------------------------------------

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventName   String
  sessionHash String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  path        String?
  referrer    String?
  country     String?
  device      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([eventName, createdAt])
  @@index([sessionHash, createdAt])
  @@index([userId, createdAt])
}

model AnalyticsDailyAggregate {
  id             String   @id @default(cuid())
  day            DateTime
  eventName      String
  country        String   @default("UNKNOWN")
  device         String   @default("UNKNOWN")
  path           String   @default("")
  count          Int      @default(0)
  uniqueSessions Int      @default(0)
  revenueCents   Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([day, eventName, country, device, path])
  @@index([day])
  @@index([eventName, day])
}
